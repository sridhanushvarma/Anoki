# Copy this file to .env.local and fill in your OAuth credentials

# Database
DATABASE_URL="file:./dev.db"

# Authentication
NEXTAUTH_SECRET="anoki-super-secret-key-for-development-only"
NEXTAUTH_URL="http://localhost:3002"

# JWT Secrets
JWT_SECRET="anoki-jwt-secret-for-development-only"
JWT_REFRESH_SECRET="anoki-jwt-refresh-secret-for-development-only"

# Google OAuth
# Get these from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your_google_client_id_here"

# GitHub OAuth
# Get these from: https://github.com/settings/developers
GITHUB_CLIENT_ID="your_github_client_id_here"
GITHUB_CLIENT_SECRET="your_github_client_secret_here"
NEXT_PUBLIC_GITHUB_CLIENT_ID="your_github_client_id_here"

# Microsoft OAuth
# Get these from: https://portal.azure.com/
MICROSOFT_CLIENT_ID="your_microsoft_client_id_here"
MICROSOFT_CLIENT_SECRET="your_microsoft_client_secret_here"
NEXT_PUBLIC_MICROSOFT_CLIENT_ID="your_microsoft_client_id_here"

# Email Configuration (for verification and password reset)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password"
FROM_EMAIL="noreply@anoki.com"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="900000"  # 15 minutes
RATE_LIMIT_MAX_ATTEMPTS="5"

# API Keys (replace with your own keys)
NEXT_PUBLIC_UPSCALE_API_KEY=sk-geAvdNhB70KUDVfSCyyTSqkyQzDNLlvU8HJG3RuAFUJhY5wV
NEXT_PUBLIC_CONVERSION_API_KEY=0Id5Ts4l0oW9CN9434Nb9qr4zVPENxV2

# Configuration
NEXT_PUBLIC_MAX_UPLOAD_SIZE=52428800  # 50MB in bytes
NEXT_PUBLIC_ENABLE_VIDEO_EDITING=false  # Set to true when video editing is implemented
