# Database Configuration
# For development: SQLite
DATABASE_URL="file:./dev.db"
# For production: PostgreSQL (recommended for Vercel)
# DATABASE_URL="postgresql://username:password@localhost:5432/anoki_db"

# Authentication Secrets
NEXTAUTH_SECRET="your-secret-key-here"
# For production, update this to your Vercel app URL
NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_URL="https://your-app.vercel.app"

# JWT Secrets
JWT_SECRET="your-jwt-secret-here"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-here"

# OAuth Providers (optional)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
MICROSOFT_CLIENT_ID="your-microsoft-client-id"
MICROSOFT_CLIENT_SECRET="your-microsoft-client-secret"

# Public OAuth Client IDs (for frontend)
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id"
NEXT_PUBLIC_GITHUB_CLIENT_ID="your-github-client-id"
NEXT_PUBLIC_MICROSOFT_CLIENT_ID="your-microsoft-client-id"

# Email Configuration (for verification and password reset)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
FROM_EMAIL="noreply@anoki.com"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="900000"  # 15 minutes
RATE_LIMIT_MAX_ATTEMPTS="5"

# API Keys (replace with your own keys in .env.local)
NEXT_PUBLIC_UPSCALE_API_KEY=sk-geAvdNhB70KUDVfSCyyTSqkyQzDNLlvU8HJG3RuAFUJhY5wV
NEXT_PUBLIC_CONVERSION_API_KEY=0Id5Ts4l0oW9CN9434Nb9qr4zVPENxV2

# Configuration
NEXT_PUBLIC_MAX_UPLOAD_SIZE=52428800  # 50MB in bytes
NEXT_PUBLIC_ENABLE_VIDEO_EDITING=false  # Set to true when video editing is implemented
